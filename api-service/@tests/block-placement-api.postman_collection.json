  "item": [
    {
      "name": "1. Status endpoints",
      "item": [
        {
          "name": "GET Position Status - 200 and schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"position status payload matches the contract\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an(\"object\");",
                  "    pm.expect(body).to.have.property(\"status\");",
                  "    pm.expect([\"pending\", \"running\", \"succeeded\", \"failed\"]).to.include(body.status);",
                  "    pm.expect(body).to.have.property(\"message\");",
                  "    pm.expect(body.message).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/position/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "position",
                "status"
              ]
            },
            "description": "Checks the latest motion-planning request status. The contract permits all four status values regardless of whether planning is pending, running, succeeded, or failed."
          },
          "response": []
        },
        {
          "name": "GET Motion Status - 200 and schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"motion status payload matches the contract\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an(\"object\");",
                  "    pm.expect(body).to.have.property(\"status\");",
                  "    pm.expect([\"pending\", \"running\", \"succeeded\", \"failed\"]).to.include(body.status);",
                  "    pm.expect(body).to.have.property(\"message\");",
                  "    pm.expect(body.message).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/motion/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "motion",
                "status"
              ]
            },
            "description": "Checks the active or most recent robot-motion execution status. The contract specifies the same four status values and a string message."
          },
          "response": []
        }
      ],
      "description": "Read-only checks. Both status endpoints are specified to return HTTP 200 and a JSON object with a status enum and string message."
    },
